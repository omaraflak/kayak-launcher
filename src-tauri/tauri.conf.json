{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kayak",
  "version": "1.0.1",
  "identifier": "com.omaraflak.kayak.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "launcher",
        "title": "Kayak",
        "width": 540,
        "height": 600,
        "resizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "shortDescription": "Runs and updates Kayak",
    "longDescription": "Kayak runs as a Docker container. This app downloads it, starts it, shows it in a window, and installs new versions when they are published.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/omaraflak/kayak-launcher/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU4MjE3RDUxMzNGNDNBRTEKUldUaE92UXpVWDBoNklibEVDaTVvelRoYXpnYWlKU2w0a2Y2QkRpUVkwcWREZ0YwQjlnZkdUNkkK"
    }
  }
}
